      "css": ".ds-search-bar{font-family:var(--claude-ui-font,'Noto Sans SC','Microsoft YaHei',system-ui,sans-serif);letter-spacing:0;display:flex;align-items:center;max-width:100%;padding:0 12px;border:1px solid var(--vp-c-divider,#e2e1dc);border-radius:4px;color:var(--vp-c-text-1,#131313);cursor:text;}.ds-search-bar:focus-within{border-color:var(--vp-c-brand-1,#184f95);}.ds-search-icon{flex:none;margin:8px;}.ds-search-input{font-family:var(--claude-ui-font,'Noto Sans SC','Microsoft YaHei',system-ui,sans-serif);letter-spacing:0;min-width:0;width:100%;border:0;border-radius:0;padding:6px 12px;font-size:16px;line-height:24px;color:var(--vp-c-text-1,#131313);background:var(--vp-c-bg-soft,#f3f3f0);}.ds-search-input:focus-visible{outline:2px solid var(--claude-link,#184f95);outline-offset:2px;}@media(max-width:767px){.ds-search-bar{padding:0 8px;}.ds-search-icon{display:none;}.ds-search-input{padding:6px 4px;}}@media(prefers-reduced-motion:reduce){:host *,:host *::before,:host *::after{scroll-behavior:auto!important;transition-duration:0.01ms!important;animation-duration:0.01ms!important;animation-iteration-count:1!important;}}"
